# Copia este archivo como .env en el servidor y llena los valores. Nunca subas el .env a GitHub.

# Dominios (deben apuntar a la IP del servidor en el DNS)
SITE_DOMAIN=www.navimovil.com
ROOT_DOMAIN=navimovil.com

# 1 = demostración: carga las 4 empresas de ejemplo, muestra el código de acceso en pantalla
#     y deja entrar a los operadores con el PIN de demo.
# 0 = producción: los códigos solo llegan por correo o SMS.
DEMO=1
DEMO_OP_PIN=1234

# Envío de códigos por SMS: log (solo bitácora del servidor, para pruebas) o twilio
SMS_PROVIDER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Envío de códigos por correo: log o sendgrid
EMAIL_PROVIDER=log
SENDGRID_KEY=
EMAIL_FROM=NAVI Órbita <no-responder@navimovil.com>

# Duración de la sesión de la consola (horas) y de "mantener sesión" (días)
SESSION_HOURS=12
SESSION_KEEP_DAYS=30
